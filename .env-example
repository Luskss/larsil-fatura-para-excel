# Banco de dados Azure SQL
DB_SERVER=your-server.database.windows.net
DB_DATABASE=your-database-name
DB_USERNAME=your-username
DB_PASSWORD=your-password

# Conexão
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# ── IAM Larsil (login único) ──────────────────────────────────────────────
# Base da Auth API. Local: http://localhost:4000
# Produção: https://painelgestor.up.railway.app
IAM_URL=http://localhost:4000

# Chave do auto-registro deste sistema (código FATURA), usada só pelo
# `npm run iam:sync`. Peça à TI — no .env da IAM ela cadastra:
#   REGISTRY_KEYS={"FATURA":"<chave>"}
IAM_REGISTRY_KEY=

# URL pública deste sistema — vai no cadastro do sistema na IAM (opcional).
APP_URL=

# Segredo do cookie de sessão do Express (troque em produção).
SESSION_SECRET=
